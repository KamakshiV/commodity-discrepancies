OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4-turbo,gpt-4,gpt-3.5-turbo,o1-mini,o3-mini

# --- Data source: local folder (default) ---
DATA_SOURCE=local
SHARED_DATA_DIR=./data/sample

# --- Data source: Google Drive (set DATA_SOURCE=google_drive) ---
# DATA_SOURCE=google_drive
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-from-drive-url
# Paste full service-account JSON on one line, OR mount a credentials file:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
